# API root for the NestJS backend. The dashboard calls real backend APIs such
# as /fraud-alerts, /security-events, /audit-logs, plus /soc analytics/cases.
VITE_API_URL=http://localhost:3000

# Optional override for the SOC compatibility endpoints. Leave blank unless
# the SOC routes are hosted separately from VITE_API_URL.
VITE_SOC_API_URL=

# Optional local development token. Do not commit a real token here.
# In normal use, the dashboard reads bankshield.auth.session.v1 from browser
# storage after signing in through the main banking frontend.
VITE_SOC_ACCESS_TOKEN=
