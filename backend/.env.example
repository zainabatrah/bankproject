# BankShield backend configuration
# Copy this file to .env and replace every placeholder before running locally.
# In production, never use localhost service URLs or shared/example secrets.

# PostgreSQL connection string used by Prisma.
# Example local-only value:
DATABASE_URL=postgresql://bankshield_user:replace-with-db-password@localhost:5432/bankshield

# Generate a unique value of at least 32 characters for every environment:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long

# Must be exactly 64 hexadecimal characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Fraud detection service base URL.
FRAUD_ENGINE_URL=http://127.0.0.1:8000

# development, test, or production.
NODE_ENV=development

# HTTP port for the NestJS API.
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Required explicitly in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
